# Backend settings for Smart Warehouse Planner. PLACEHOLDERS ONLY: never commit a real value.
# Copy this file to backend/.env (git ignores it), fill in your own values, and export them
# before starting, e.g. from the repo root: set -a; . backend/.env; set +a; npm run dev
# A local run needs none of these; every setting has a safe local default.
# VERCEL is set by the platform on Vercel; do not set it yourself.

# Turns accounts on for a local run: every page needs a session (default false).
FEATURE_AUTH=true

# local (default) or production. Production refuses unsafe settings at startup.
# APP_ENV=local
# Public demo: front page, Demo version and the demo limits (default false).
# FEATURE_DEMO=false
# Password of the seeded `demo` account, used when it is first created (default demo).
# DEMO_PASSWORD=demo

# App database (default: SQLite at backend/var/swp.db); on Supabase, the pooled connection.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
# Database `swp db upgrade` migrates (default: DATABASE_URL); on Supabase, the direct connection.
# It must be the same database as DATABASE_URL (only the connection differs): the seed uses DATABASE_URL.
# MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# Session signing key, at least 32 bytes; production refuses this placeholder.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# Largest upload in bytes (default 4000000).
# MAX_UPLOAD_BYTES=4000000
# Most rows read from one file (default 25000).
# MAX_ROWS_PER_FILE=25000
# Most saved plans while FEATURE_DEMO is on (default 50).
# MAX_PLANS=50
# Most accounts while FEATURE_DEMO is on (default 200).
# MAX_ACCOUNTS=200
