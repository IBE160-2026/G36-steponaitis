{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["arn1"],
  "services": {
    "web": {
      "root": "frontend/",
      "framework": "nextjs"
    },
    "api": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "swp.main:app",
      "functions": {
        "swp/main.py": {
          "excludeFiles": "{tests/**,var/**}",
          "regions": ["arn1"]
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ],
  "git": {
    "deploymentEnabled": { "**": false, "main": true }
  }
}
