"13" cy="10" r="1.7" fill="#fff"/><circle cx="9" cy="14.5" r="1.7" fill="#fff"/></g></symbol><symbol id="i-stack" viewBox="0 0 20 20"><g class="ic"><path d="M10 3 17 6.5 10 10 3 6.5z"/><path d="M3 10l7 3.5 7-3.5M3 13.5 10 17l7-3.5"/></g></symbol><symbol id="i-plus" viewBox="0 0 20 20"><g class="ic"><path d="M10 4v12M4 10h12"/></g></symbol><symbol id="i-wall" viewBox="0 0 20 20"><g class="ic"><rect x="3" y="3" width="14" height="14" rx="1"/><path d="M3 8h14M3 12.5h14M8 3v14M12.5 3v14"/></g></symbol><symbol id="i-tag" viewBox="0 0 20 20"><g class="ic"><path d="M3 3h7l7 7-7 7-7-7z"/><circle cx="7" cy="7" r="1.3"/></g></symbol><symbol id="i-qr" viewBox="0 0 20 20"><g class="ic"><rect x="3" y="3" width="5" height="5"/><rect x="12" y="3" width="5" height="5"/><rect x="3" y="12" width="5" height="5"/><path d="M12 12h2v2M17 12v5h-3M12 16v1"/></g></symbol><symbol id="i-person" viewBox="0 0 20 20"><g class="ic"><circle cx="10" cy="7" r="3.2"/><path d="M3.8 17c.8-3.4 3.3-5 6.2-5s5.4 1.6 6.2 5"/></g></symbol><symbol id="i-search" viewBox="0 0 20 20"><g class="ic"><circle cx="8.5" cy="8.5" r="5"/><path d="M12.3 12.3 17 17"/></g></symbol><symbol id="i-chev-d" viewBox="0 0 20 20"><g class="ic"><path d="M5.5 8 10 12.5 14.5 8"/></g></symbol><symbol id="i-chev-r" viewBox="0 0 20 20"><g class="ic"><path d="M8 5.5 12.5 10 8 14.5"/></g></symbol><symbol id="i-check" viewBox="0 0 20 20"><g class="ic"><path d="M4.5 10.5 8.3 14 15.5 6.5"/></g></symbol><symbol id="i-undo" viewBox="0 0 20 20"><g class="ic"><path d="M7 5.5 3.5 9 7 12.5"/><path d="M3.5 9h8.5a4.5 4.5 0 0 1 0 9H9"/></g></symbol><symbol id="i-lock" viewBox="0 0 20 20"><g class="ic"><rect x="4.5" y="9" width="11" height="8" rx="1.2"/><path d="M7 9V6.5a3 3 0 0 1 6 0V9"/></g></symbol><symbol id="i-play" viewBox="0 0 20 20"><g class="ic"><path d="M6.5 4.5v11l9-5.5z"/></g></symbol><symbol id="i-x" viewBox="0 0 20 20"><g class="ic"><path d="M5.5 5.5l9 9M14.5 5.5l-9 9"/></g></symbol><symbol id="i-pin" viewBox="0 0 20 20"><g class="ic"><p