<defs>
<style>
@import url('https://fonts.googleapis.com/css2?family=Barlow+Semi+Condensed:wght@500;600;700&amp;family=Figtree:wght@400;500;600;700&amp;display=swap');
text { font-variant-numeric: tabular-nums; }
.lb { font-family: 'Barlow Semi Condensed', 'Arial Narrow', 'Helvetica Neue', Arial, sans-serif; }
.b { font-family: Figtree, 'Helvetica Neue', Helvetica, Arial, sans-serif; }
.w4 { font-weight: 400; } .w5 { font-weight: 500; } .w6 { font-weight: 600; } .w7 { font-weight: 700; }
.ic { fill: none; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
</style>
